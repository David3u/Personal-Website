{
  "name": "resume",
  "version": "0.1.0",
  "description": "Personal portfolio and resume website built with Next.js.",
  "private": true,
  "scripts": {
    "dev": "node server.mjs dev",
    "build": "next build",
    "start": "node server.mjs start",
    "test:download-links": "node --experimental-strip-types --test tests/download-links.test.mjs",
    "tunnel:check": "node --check server.mjs && node --check tools/3utunnel/server.mjs && node --check tools/3utunnel/shared.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run tunnel:check"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
